# Generated by the umbrella release.sh — do not hand-edit except to test an unreleased upstream
# locally (any git ref works: a tag, a branch, a SHA). The next release overwrites it.
#
# The upstream refs this Studio release is built against. The `package` job of
# .github/workflows/ci.yml checks these three repos out at these refs and `mvn install`s them at
# 0.0.0-SNAPSHOT — the version this pom's properties already default to — so the release build
# resolves them from source and never touches JitPack. That is what lets studio be tagged before
# the shared/session/sdk JitPack builds have landed, instead of behind them.

SHARED_TAG=v0.0.15
SESSION_TAG=v0.0.3
SDK_TAG=v1.0.21
